# Public browser configuration. All VITE_ variables are included in the build.
# Never place private keys, seeds, backup codes, or API secrets here.

# Optional RPC endpoints. Public BNB Chain endpoints are used by default.
VITE_BSC_TESTNET_RPC=https://bsc-testnet-dataseed.bnbchain.org
VITE_BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org

# Set a verified deployment address to enable new vault creation on that network.
# This repository does not select a production deployment for you.
VITE_BSC_TESTNET_FACTORY=
VITE_BSC_MAINNET_FACTORY=

# scripts/deploy.mjs reads RPC_URL and DEPLOYER_PRIVATE_KEY from the process
# environment only. Never commit a real deployment secret to this file.
